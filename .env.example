# Copy to .env and fill in one provider key.  Never commit .env itself.
#
# VLM_PROVIDER is load-bearing.  If you leave it empty, a .env that contains a
# provider key is enough: get_default_provider() infers "groq" from
# GROQ_API_KEY, then "openai", then "gemini", and "disabled" when there is no
# key at all.  Set it explicitly to pin the provider, e.g. VLM_PROVIDER=mock to
# rehearse the agent without calling a real model.
VLM_PROVIDER=

# Set exactly one of these.  gsk_ keys are Groq, they start with "gsk_".
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# quiet | normal | debug
VLM_LOG_LEVEL=warning
